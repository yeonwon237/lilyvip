{
  "name": "lilyvip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-vits-web-memory.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:book-engine": "node src/book-engine/__tests__/run-tests.mjs && tsx src/book-engine/__tests__/run-tests.ts && tsx src/book-engine/__tests__/import-integrity.test.ts",
    "test:audio": "node --experimental-strip-types src/audio-engine/__tests__/speech-normalization.test.ts && tsx src/audio-engine/__tests__/queue-integrity.test.ts",
    "test:pwa": "node scripts/test-pwa-build.mjs",
    "test:backup": "tsx src/book-engine/__tests__/backup-integrity.test.ts",
    "test:website": "tsx scripts/test-website-import.ts",
    "test:business": "tsx scripts/test-business-readiness.ts",
    "test:jjwxc": "tsx src/book-engine/jjwxc-source/__tests__/jjwxc-source.test.ts && tsx src/book-engine/jjwxc-source/__tests__/jjwxc-phase2.test.ts && tsx src/book-engine/jjwxc-source/__tests__/jjwxc-phase2_5.test.ts && tsx src/book-engine/jjwxc-source/__tests__/jjwxc-adapter.test.ts",
    "test": "npm run test:book-engine && npm run test:audio && npm run test:backup && npm run test:website && npm run test:business && npm run test:jjwxc"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "1.0.3",
    "@huggingface/transformers": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
